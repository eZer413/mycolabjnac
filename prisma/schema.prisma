// MycoLab — Prisma schema (SQLite, local file DB).
// Outcome is stored as a String because SQLite does not support native enums;
// values are validated with Zod (CLEAN | CONTAMINATED | FRUITED | DISCARDED).

generator client {
  provider        = "prisma-client-js"
  // Driver adapters let the client talk to Turso (libSQL) in production while
  // still using a plain local SQLite file for `prisma migrate dev`.
  previewFeatures = ["driverAdapters"]
  // Include the Linux engine binaries so the client runs on Vercel's serverless
  // (AWS Lambda) runtime, not just the local machine. Covers Node 18 (1.0.x) and
  // Node 20+/AL2023 (3.0.x).
  binaryTargets   = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Batch {
  // Human-readable id, e.g. "AUR-0704-01" (speciesCode-MMDD-dailySequence).
  id                  String   @id
  species             String
  quantity            Int      @default(1) // number of bags/plates in this inoculation event
  pdaBatchRef         String? // free-text reference to the PDA media prep used
  sterilizationMethod String
  inoculationDate     DateTime
  zone                String
  outcome             String   @default("CLEAN") // CLEAN | CONTAMINATED | FRUITED | DISCARDED
  notes               String?
  createdAt           DateTime @default(now())

  @@index([outcome])
  @@index([inoculationDate])
}

model Consumable {
  id        String @id @default(cuid())
  name      String @unique
  unit      String
  stock     Float  @default(0)
  threshold Float  @default(0)
}

// Key/value store for editable base ratios and editable option lists.
// JSON-encoded values are stored as strings.
model Setting {
  key   String @id
  value String
}
