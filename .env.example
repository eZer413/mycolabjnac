# --- Local development ---
# Plain SQLite file. Used by `prisma migrate dev` and by the app when the TURSO_*
# vars below are NOT set. Leave this as-is for local work.
DATABASE_URL="file:./dev.db"

# Disable Next.js telemetry (its cross-device config write fails on some machines).
NEXT_TELEMETRY_DISABLED=1

# --- Production (Turso, used on Vercel) ---
# When these are set, the app connects to Turso instead of the local file.
# Get them from the Turso CLI:
#   turso db show mycolab --url        -> TURSO_DATABASE_URL (libsql://...)
#   turso db tokens create mycolab     -> TURSO_AUTH_TOKEN
# Set the real values in the Vercel dashboard (Project → Settings → Environment
# Variables). To test locally against Turso, put them in an untracked .env.local.
# TURSO_DATABASE_URL="libsql://mycolab-<org>.turso.io"
# TURSO_AUTH_TOKEN="your-token-here"
