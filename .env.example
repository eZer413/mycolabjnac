# --- Local development ---
# Plain SQLite file. Used by `prisma migrate dev` and by the app when the TURSO_*
# vars below are NOT set. Leave this as-is for local work.
DATABASE_URL="file:./dev.db"

# Disable Next.js telemetry (its cross-device config write fails on some machines).
NEXT_TELEMETRY_DISABLED=1

# --- Production (Turso, used on Vercel) ---
# When these are set, the app connects to Turso instead of the local file.
# Get them from the Turso CLI:
#   turso db show mycolab --url        -> TURSO_DATABASE_URL (libsql://...)
#   turso db tokens create mycolab     -> TURSO_AUTH_TOKEN
# Set the real values in the Vercel dashboard (Project → Settings → Environment
# Variables). To test locally against Turso, put them in an untracked .env.local.
# TURSO_DATABASE_URL="libsql://mycolab-<org>.turso.io"
# TURSO_AUTH_TOKEN="your-token-here"

# --- Offline app cloud sync (Phase 2) ---
# The installed app / browser client syncs to Turso DIRECTLY from the device over
# HTTPS, so these must be NEXT_PUBLIC_ — they get baked into the client bundle and
# the Android APK. That exposes the token to anyone holding the app files, which is
# fine for a personal debug APK; for a shared or public build, put a small proxy in
# front of Turso instead of shipping the token. Same values as above; get them via:
#   turso db show mycolab --url      -> NEXT_PUBLIC_TURSO_DATABASE_URL
#   turso db tokens create mycolab   -> NEXT_PUBLIC_TURSO_AUTH_TOKEN
# With these unset, the app simply runs offline-only (no sync, no errors).
# NEXT_PUBLIC_TURSO_DATABASE_URL="libsql://mycolab-<org>.turso.io"
# NEXT_PUBLIC_TURSO_AUTH_TOKEN="your-token-here"
