{
  "name": "mycolab",
  "version": "1.0.0",
  "private": true,
  "description": "MycoLab — mushroom cultivation lab manager for a solo operator (mobile-first).",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:push:turso": "node scripts/push-schema.mjs",
    "cap:sync": "next build && cap sync android",
    "cap:open": "cap open android",
    "android:icons": "capacitor-assets generate --android"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@libsql/client": "^0.8.1",
    "@prisma/adapter-libsql": "^5.22.0",
    "@prisma/client": "5.22.0",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^1.1.7",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.19",
    "postcss": "8.4.39",
    "prisma": "5.22.0",
    "sharp": "^0.33.5",
    "tailwindcss": "3.4.6",
    "tsx": "4.16.2",
    "typescript": "5.5.3"
  }
}
